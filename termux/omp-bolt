#!/data/data/com.termux/files/usr/bin/bash
# omp-bolt for Termux (Track B: Pi-Bolt AOT image, glibc addon).
set -euo pipefail

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
LIBEXEC="$PREFIX/libexec/omp-bolt"
LOADER="$PREFIX/glibc/lib/ld-linux-aarch64.so.1"

export TMPDIR="$PREFIX/tmp" TMP="$PREFIX/tmp" TEMP="$PREFIX/tmp"
mkdir -p "$TMPDIR"

export OMP_PACKAGE_DIR="$LIBEXEC"
export PI_NATIVES_DIR="${PI_NATIVES_DIR:-$HOME/.omp/natives}"
export LANG="${LANG:-C.UTF-8}" LC_ALL="${LC_ALL:-C.UTF-8}"
unset LD_PRELOAD
export SHELL="$PREFIX/bin/bash"
export PATH="$PREFIX/bin:$PATH"
export OMP_MANAGED_INSTALL=1

# The installer swaps the ELF interpreter to the Termux glibc loader so that
# omp's own respawns of process.execPath stay on glibc. Without patchelf, run
# through the loader explicitly.
if [ -e "$LIBEXEC/.interpreter-patched" ]; then
	exec "$LIBEXEC/omp-bolt" "$@"
fi
exec "$LOADER" --library-path "$PREFIX/glibc/lib" "$LIBEXEC/omp-bolt" "$@"
